#!/usr/bin/env python3

import re
import subprocess
from gradelib import *

r = Runner(save("xv6.out.tv1"))


@test(10, "TV1 sleep arguments and return to shell")
def test_sleep_arguments():
    r.run_qemu(shell_script([
        'sleep', 'sleep 1 2', 'sleep -1', 'sleep abc',
        'sleep 2147483648', 'sleep 99999999999999999999',
        'sleep 0', 'sleep 10', 'echo TV1_SLEEP_OK'
    ]))
    output = r.qemu.output
    assert_equal(output.count('sleep: usage: sleep ticks'), 2)
    assert_equal(output.count('sleep: ticks must be an integer'), 4)
    r.match('^TV1_SLEEP_OK$', no=['exec .* failed'])


@test(10, "TV1 pingpong repeated 50 times")
def test_pingpong_repeated():
    r.run_qemu(shell_script(['pingpong'] * 50 + ['echo TV1_PINGPONG_OK']))
    messages = re.findall(r'^(\d+): received (ping|pong)$', r.qemu.output, re.M)
    assert_equal(len(messages), 100)
    for i in range(0, len(messages), 2):
        assert_equal([messages[i][1], messages[i + 1][1]], ['ping', 'pong'])
        if messages[i][0] == messages[i + 1][0]:
            raise AssertionError('ping and pong must come from different processes')
    r.match('^TV1_PINGPONG_OK$', no=['pingpong:', 'exec .* failed'])


@test(10, "TV1 primes exact output, repeated 20 times")
def test_primes_repeated():
    # Trial division is independent of the pipe-based sieve being tested.
    expected = [n for n in range(2, 281)
                if all(n % d != 0 for d in range(2, n))]
    r.run_qemu(shell_script(['primes'] * 20 + ['echo TV1_PRIMES_OK']))
    actual = [int(n) for n in re.findall(r'^prime (\d+)$', r.qemu.output, re.M)]
    assert_equal(actual, expected * 20)
    r.match('^TV1_PRIMES_OK$', no=['primes:', 'exec .* failed'])


@test(10, "TV1 programs used in shell pipelines")
def test_pipelines():
    r.run_qemu(shell_script([
        'primes | wc', 'pingpong | cat', 'echo TV1_PIPELINE_OK'
    ]))
    r.match(r'^59 118 \d+ *$', r'^\d+: received ping$',
            r'^\d+: received pong$', '^TV1_PIPELINE_OK$',
            no=['primes:', 'pingpong:', 'exec .* failed'])


@test(10, "TV1 exit statuses and elapsed xv6 ticks")
def test_status_and_ticks():
    subprocess.run(['make', '-s', 'user/_tv1check'], check=True)
    r.run_qemu(shell_script(['tv1check']),
               make_args=['UEXTRA=user/xargstest.sh user/_tv1check'])
    r.match(r'^sleep 10: \d+ ticks elapsed$', '^TV1_STATUS_OK$',
            no=['tv1check:', 'exec .* failed'])


run_tests()
