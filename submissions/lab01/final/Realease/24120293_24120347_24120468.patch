diff --git a/user/cp.c b/user/cp.c
new file mode 100644
index 0000000..91521b8
--- /dev/null
+++ b/user/cp.c
@@ -0,0 +1,90 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/fcntl.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+    int src, dst;
+    int n;
+    char buffer[1024];
+    struct stat src_stat, dst_stat;
+
+    if (argc != 3) {
+        fprintf(2, "cp: usage: cp source destination\n");
+        exit(1);
+    }
+
+    // Mo file nguon de doc.
+    src = open(argv[1], O_RDONLY);
+    if (src < 0) {
+        fprintf(2, "cp: cannot open %s\n", argv[1]);
+        exit(1);
+    }
+
+    if (fstat(src, &src_stat) < 0) {
+        fprintf(2, "cp: cannot stat %s\n", argv[1]);
+        close(src);
+        exit(1);
+    }
+
+    if (src_stat.type != T_FILE) {
+        fprintf(2, "cp: %s is not a regular file\n", argv[1]);
+        close(src);
+        exit(1);
+    }
+
+    // Kiem tra truoc khi xoa noi dung cu cua file dich.
+    if (stat(argv[2], &dst_stat) == 0) {
+        if (src_stat.dev == dst_stat.dev &&
+            src_stat.ino == dst_stat.ino) {
+            fprintf(2, "cp: source and destination are the same file\n");
+            close(src);
+            exit(1);
+        }
+
+        if (dst_stat.type != T_FILE) {
+            fprintf(2, "cp: %s is not a regular file\n", argv[2]);
+            close(src);
+            exit(1);
+        }
+    }
+
+    // Tao file neu chua co; xoa noi dung cu neu da co.
+    dst = open(argv[2], O_WRONLY | O_CREATE | O_TRUNC);
+    if (dst < 0) {
+        fprintf(2, "cp: cannot open %s\n", argv[2]);
+        close(src);
+        exit(1);
+    }
+
+    // Doc tung khoi, ghi het khoi do roi moi doc tiep.
+    while ((n = read(src, buffer, sizeof(buffer))) > 0) {
+        int written = 0;
+
+        while (written < n) {
+            int count = write(dst, buffer + written, n - written);
+
+            if (count <= 0) {
+                fprintf(2, "cp: write failed for %s\n", argv[2]);
+                close(src);
+                close(dst);
+                exit(1);
+            }
+
+            written += count;
+        }
+    }
+
+    if (n < 0) {
+        fprintf(2, "cp: read failed for %s\n", argv[1]);
+        close(src);
+        close(dst);
+        exit(1);
+    }
+
+    close(src);
+    close(dst);
+    exit(0);
+}
diff --git a/user/diff.c b/user/diff.c
new file mode 100644
index 0000000..a6eacf1
--- /dev/null
+++ b/user/diff.c
@@ -0,0 +1,186 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/fcntl.h"
+#include "user/user.h"
+
+// Tra ve: so byte cua dong, 0 neu EOF, so am neu loi.
+// Giu ca newline de phan biet dong cuoi co/khong co newline.
+static int
+read_line(int fd, char **buffer, int *capacity)
+{
+    int length = 0;
+
+    for (;;) {
+        char c;
+        int n = read(fd, &c, 1);
+
+        if (n < 0)
+            return -1;
+
+        if (n == 0)
+            return length;
+
+        if (length == *capacity) {
+            if (*capacity >= (1 << 28))
+                return -2;
+
+            int new_capacity = *capacity ? *capacity * 2 : 128;
+            char *new_buffer = malloc(new_capacity);
+
+            if (new_buffer == 0)
+                return -2;
+
+            if (length > 0)
+                memmove(new_buffer, *buffer, length);
+            if (*buffer != 0)
+                free(*buffer);
+            *buffer = new_buffer;
+            *capacity = new_capacity;
+        }
+
+        (*buffer)[length++] = c;
+
+        if (c == '\n')
+            return length;
+    }
+}
+
+static int
+same_line(char *a, int na, char *b, int nb)
+{
+    if (na != nb)
+        return 0;
+
+    for (int i = 0; i < na; i++) {
+        if (a[i] != b[i])
+            return 0;
+    }
+
+    return 1;
+}
+
+static void
+print_line(char marker, char *name, int number,
+           char *buffer, int length)
+{
+    printf("%s %s:%d: ", marker == '<' ? "<" : ">", name, number);
+
+    // Khong dung %s vi buffer khong can ky tu ket thuc '\0'.
+    write(1, buffer, length);
+
+    if (buffer[length - 1] != '\n') {
+        printf("\n");
+        printf("\\ No newline at end of file\n");
+    }
+}
+
+static int
+open_file(char *name)
+{
+    struct stat st;
+    int fd = open(name, O_RDONLY);
+
+    if (fd < 0) {
+        fprintf(2, "diff: cannot open %s\n", name);
+        return -1;
+    }
+
+    if (fstat(fd, &st) < 0 || st.type != T_FILE) {
+        fprintf(2, "diff: %s is not a regular file\n", name);
+        close(fd);
+        return -1;
+    }
+
+    return fd;
+}
+
+int
+main(int argc, char *argv[])
+{
+    char *names[2];
+    int file_count = 0;
+    int quiet = 0;
+
+    // Chap nhan -q truoc hoac sau hai ten file.
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-q") == 0) {
+            if (quiet)
+                goto usage;
+            quiet = 1;
+        } else {
+            if (argv[i][0] == '-' || file_count == 2)
+                goto usage;
+
+            names[file_count++] = argv[i];
+        }
+    }
+
+    if (file_count != 2)
+        goto usage;
+
+    int fd1 = open_file(names[0]);
+    if (fd1 < 0)
+        exit(2);
+
+    int fd2 = open_file(names[1]);
+    if (fd2 < 0) {
+        close(fd1);
+        exit(2);
+    }
+
+    char *line1 = 0;
+    char *line2 = 0;
+    int capacity1 = 0;
+    int capacity2 = 0;
+    int number = 1;
+    int result = 0;
+
+    for (;;) {
+        int n1 = read_line(fd1, &line1, &capacity1);
+        int n2 = read_line(fd2, &line2, &capacity2);
+
+        if (n1 < 0 || n2 < 0) {
+            if (n1 == -2 || n2 == -2)
+                fprintf(2, "diff: cannot allocate memory for line\n");
+            else
+                fprintf(2, "diff: read error\n");
+
+            result = 2;
+            break;
+        }
+
+        if (n1 == 0 && n2 == 0)
+            break;
+
+        if (!same_line(line1, n1, line2, n2)) {
+            result = 1;
+
+            if (quiet) {
+                printf("diff: files differ\n");
+                break;
+            }
+
+            if (n1 > 0)
+                print_line('<', names[0], number, line1, n1);
+
+            if (n2 > 0)
+                print_line('>', names[1], number, line2, n2);
+        }
+
+        number++;
+    }
+
+    if (line1 != 0) {
+        free(line1);
+    }
+    if (line2 != 0) {
+        free(line2);
+    }
+    close(fd1);
+    close(fd2);
+    exit(result);
+
+usage:
+    fprintf(2, "diff: usage: diff file1 file2 [-q]\n");
+    exit(2);
+}
diff --git a/user/du.c b/user/du.c
new file mode 100644
index 0000000..8590165
--- /dev/null
+++ b/user/du.c
@@ -0,0 +1,123 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+#include "kernel/fs.h"
+#include "kernel/param.h"
+#include "kernel/fcntl.h"
+
+static int option_a, option_s;
+
+static char*
+fmtpath(char *parent, char *child, char *buf)
+{
+  int length = strlen(parent);
+  int slash = length > 0 && parent[length - 1] != '/';
+
+  if(length + slash + strlen(child) >= MAXPATH)
+    return 0;
+  strcpy(buf, parent);
+  if(slash)
+    buf[length++] = '/';
+  strcpy(buf + length, child);
+  return buf;
+}
+
+// printf cua xv6 nay van rut gon %lu ve 32 bit; doi uint64 sang chuoi.
+static void
+print_size(uint64 size, char *path)
+{
+  char digits[21];
+  int i = sizeof(digits) - 1;
+
+  digits[i] = 0;
+  do {
+    digits[--i] = '0' + size % 10;
+    size /= 10;
+  } while(size != 0);
+  printf("%s\t%s\n", digits + i, path);
+}
+
+static int
+du(char *path, uint64 *size)
+{
+  int fd, n, status = 0;
+  struct stat st;
+  struct dirent de;
+  char buf[MAXPATH], name[DIRSIZ + 1];
+  uint64 total = 0, child_size;
+
+  if((fd = open(path, O_RDONLY)) < 0){
+    fprintf(2, "du: cannot open %s\n", path);
+    return 1;
+  }
+  if(fstat(fd, &st) < 0){
+    fprintf(2, "du: cannot stat %s\n", path);
+    close(fd);
+    return 1;
+  }
+  if(st.type != T_DIR){
+    *size = st.type == T_FILE ? st.size : 0;
+    close(fd);
+    if(option_a && !option_s)
+      print_size(*size, path);
+    return 0;
+  }
+
+  while((n = read(fd, &de, sizeof(de))) == sizeof(de)){
+    if(de.inum == 0)
+      continue;
+    memmove(name, de.name, DIRSIZ);
+    name[DIRSIZ] = 0;
+    if(strcmp(name, ".") == 0 || strcmp(name, "..") == 0)
+      continue;
+    if(fmtpath(path, name, buf) == 0){
+      fprintf(2, "du: path too long: %s/%s\n", path, name);
+      status = 1;
+      continue;
+    }
+    if(du(buf, &child_size) != 0)
+      status = 1;
+    else
+      total += child_size;
+  }
+  if(n != 0){
+    fprintf(2, "du: cannot read directory %s\n", path);
+    status = 1;
+  }
+  close(fd);
+  *size = total;
+  if(!option_s && status == 0)
+    print_size(total, path);
+  return status;
+}
+
+int
+main(int argc, char *argv[])
+{
+  char *path = ".";
+  int pathset = 0;
+  uint64 total;
+
+  for(int i = 1; i < argc; i++){
+    if(strcmp(argv[i], "-a") == 0){
+      option_a = 1;
+    } else if(strcmp(argv[i], "-s") == 0){
+      option_s = 1;
+    } else if(argv[i][0] == '-' || pathset){
+      fprintf(2, "du: usage: du [path] [-a] [-s]\n");
+      exit(1);
+    } else {
+      path = argv[i];
+      pathset = 1;
+    }
+  }
+  if(strlen(path) >= MAXPATH){
+    fprintf(2, "du: path too long\n");
+    exit(1);
+  }
+  if(du(path, &total) != 0)
+    exit(1);
+  if(option_s)
+    print_size(total, path);
+  exit(0);
+}
diff --git a/user/pingpong.c b/user/pingpong.c
new file mode 100644
index 0000000..564c1cf
--- /dev/null
+++ b/user/pingpong.c
@@ -0,0 +1,72 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  int tochild[2], toparent[2];
+  int pid, status = 0, childstatus;
+  char byte = 'x';
+
+  if(argc != 1){
+    fprintf(2, "pingpong: usage: pingpong\n");
+    exit(1);
+  }
+  if(pipe(tochild) < 0){
+    fprintf(2, "pingpong: pipe failed\n");
+    exit(1);
+  }
+  if(pipe(toparent) < 0){
+    fprintf(2, "pingpong: pipe failed\n");
+    close(tochild[0]);
+    close(tochild[1]);
+    exit(1);
+  }
+
+  pid = fork();
+  if(pid < 0){
+    fprintf(2, "pingpong: fork failed\n");
+    close(tochild[0]);
+    close(tochild[1]);
+    close(toparent[0]);
+    close(toparent[1]);
+    exit(1);
+  }
+
+  if(pid == 0){
+    close(tochild[1]);
+    close(toparent[0]);
+    if(read(tochild[0], &byte, 1) != 1){
+      fprintf(2, "pingpong: child could not read ping\n");
+      close(tochild[0]);
+      close(toparent[1]);
+      exit(1);
+    }
+    close(tochild[0]);
+    printf("%d: received ping\n", getpid());
+    if(write(toparent[1], &byte, 1) != 1){
+      fprintf(2, "pingpong: child could not write pong\n");
+      status = 1;
+    }
+    close(toparent[1]);
+    exit(status);
+  }
+
+  close(tochild[0]);
+  close(toparent[1]);
+  if(write(tochild[1], &byte, 1) != 1){
+    fprintf(2, "pingpong: parent could not write ping\n");
+    status = 1;
+  }
+  close(tochild[1]);
+  if(read(toparent[0], &byte, 1) != 1){
+    fprintf(2, "pingpong: parent could not read pong\n");
+    status = 1;
+  } else {
+    printf("%d: received pong\n", getpid());
+  }
+  close(toparent[0]);
+  if(wait(&childstatus) < 0 || childstatus != 0)
+    status = 1;
+  exit(status);
+}
diff --git a/user/primes.c b/user/primes.c
new file mode 100644
index 0000000..f6baf22
--- /dev/null
+++ b/user/primes.c
@@ -0,0 +1,113 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+// Each child continues as the next filter, without growing the call stack.
+static int
+sieve(int input)
+{
+  int prime, number, n, p[2], pid, status, childstatus;
+
+  for(;;){
+    n = read(input, &prime, sizeof(prime));
+    if(n != sizeof(prime)){
+      close(input);
+      if(n == 0)
+        return 0;
+      fprintf(2, "primes: read failed\n");
+      return 1;
+    }
+    printf("prime %d\n", prime);
+
+    // A new filter is needed only after a number survives this filter.
+    while((n = read(input, &number, sizeof(number))) == sizeof(number)){
+      if(number % prime != 0)
+        break;
+    }
+    if(n != sizeof(number)){
+      close(input);
+      if(n == 0)
+        return 0;
+      fprintf(2, "primes: read failed\n");
+      return 1;
+    }
+
+    if(pipe(p) < 0){
+      fprintf(2, "primes: pipe failed\n");
+      close(input);
+      return 1;
+    }
+    pid = fork();
+    if(pid < 0){
+      fprintf(2, "primes: fork failed\n");
+      close(input);
+      close(p[0]);
+      close(p[1]);
+      return 1;
+    }
+    if(pid == 0){
+      close(input);
+      close(p[1]);
+      input = p[0];
+      continue;
+    }
+
+    close(p[0]);
+    status = 0;
+    do {
+      if(number % prime != 0 &&
+         write(p[1], &number, sizeof(number)) != sizeof(number)){
+        fprintf(2, "primes: write failed\n");
+        status = 1;
+        break;
+      }
+    } while((n = read(input, &number, sizeof(number))) == sizeof(number));
+    if(n != 0 && n != sizeof(number)){
+      fprintf(2, "primes: read failed\n");
+      status = 1;
+    }
+    close(input);
+    close(p[1]); // Let the next filter observe EOF before waiting for it.
+    if(wait(&childstatus) < 0 || childstatus != 0)
+      status = 1;
+    return status;
+  }
+}
+
+int
+main(int argc, char *argv[])
+{
+  int p[2], pid, number, status = 0, childstatus;
+
+  if(argc != 1){
+    fprintf(2, "primes: usage: primes\n");
+    exit(1);
+  }
+  if(pipe(p) < 0){
+    fprintf(2, "primes: pipe failed\n");
+    exit(1);
+  }
+  pid = fork();
+  if(pid < 0){
+    fprintf(2, "primes: fork failed\n");
+    close(p[0]);
+    close(p[1]);
+    exit(1);
+  }
+  if(pid == 0){
+    close(p[1]);
+    exit(sieve(p[0]));
+  }
+
+  close(p[0]);
+  for(number = 2; number <= 280; number++){
+    if(write(p[1], &number, sizeof(number)) != sizeof(number)){
+      fprintf(2, "primes: write failed\n");
+      status = 1;
+      break;
+    }
+  }
+  close(p[1]);
+  if(wait(&childstatus) < 0 || childstatus != 0)
+    status = 1;
+  exit(status);
+}
diff --git a/user/sleep.c b/user/sleep.c
new file mode 100644
index 0000000..4c6f93d
--- /dev/null
+++ b/user/sleep.c
@@ -0,0 +1,35 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  int i, ticks;
+  uint value = 0;
+
+  if(argc != 2){
+    fprintf(2, "sleep: usage: sleep ticks\n");
+    exit(1);
+  }
+
+  // Check the number before atoi, which does not report invalid input.
+  if(argv[1][0] == '\0'){
+    fprintf(2, "sleep: ticks must be a non-negative integer\n");
+    exit(1);
+  }
+  for(i = 0; argv[1][i]; i++){
+    if(argv[1][i] < '0' || argv[1][i] > '9' ||
+       value > (2147483647U - (argv[1][i] - '0')) / 10){
+      fprintf(2, "sleep: ticks must be an integer from 0 to 2147483647\n");
+      exit(1);
+    }
+    value = value * 10 + argv[1][i] - '0';
+  }
+
+  ticks = atoi(argv[1]);
+  if(sleep(ticks) < 0){
+    fprintf(2, "sleep: system call failed\n");
+    exit(1);
+  }
+  exit(0);
+}
diff --git a/user/tree.c b/user/tree.c
new file mode 100644
index 0000000..07d33cc
--- /dev/null
+++ b/user/tree.c
@@ -0,0 +1,127 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+#include "kernel/fs.h"
+#include "kernel/param.h"
+#include "kernel/fcntl.h"
+
+// Noi duong dan, ke ca truong hop parent da co dau '/' o cuoi.
+static char*
+fmtpath(char *parent, char *child, char *buf)
+{
+  int length = strlen(parent);
+  int slash = length > 0 && parent[length - 1] != '/';
+
+  if(length + slash + strlen(child) >= MAXPATH)
+    return 0;
+  strcpy(buf, parent);
+  if(slash)
+    buf[length++] = '/';
+  strcpy(buf + length, child);
+  return buf;
+}
+
+static int
+tree(char *path, int level, int maxDepth, int onlyDir)
+{
+  int fd, n, status = 0;
+  struct stat st;
+  struct dirent de;
+  char buf[MAXPATH], name[DIRSIZ + 1];
+
+  if((fd = open(path, O_RDONLY)) < 0){
+    fprintf(2, "tree: cannot open %s\n", path);
+    return 1;
+  }
+  if(fstat(fd, &st) < 0){
+    fprintf(2, "tree: cannot stat %s\n", path);
+    close(fd);
+    return 1;
+  }
+  if(level == 1)
+    printf("%s\n", path);
+  if(st.type != T_DIR || (maxDepth != -1 && level > maxDepth)){
+    close(fd);
+    return 0;
+  }
+
+  while((n = read(fd, &de, sizeof(de))) == sizeof(de)){
+    if(de.inum == 0)
+      continue;
+    // Ten trong dirent co the du 14 byte va khong co ky tu ket thuc.
+    memmove(name, de.name, DIRSIZ);
+    name[DIRSIZ] = 0;
+    if(strcmp(name, ".") == 0 || strcmp(name, "..") == 0)
+      continue;
+    if(fmtpath(path, name, buf) == 0){
+      fprintf(2, "tree: path too long: %s/%s\n", path, name);
+      status = 1;
+      continue;
+    }
+    if(stat(buf, &st) < 0){
+      fprintf(2, "tree: cannot stat %s\n", buf);
+      status = 1;
+      continue;
+    }
+    if(onlyDir && st.type != T_DIR)
+      continue;
+    for(int i = 0; i < level - 1; i++)
+      printf("|   ");
+    printf("|-- %s\n", name);
+    if(st.type == T_DIR && (maxDepth == -1 || level < maxDepth)){
+      if(tree(buf, level + 1, maxDepth, onlyDir) != 0)
+        status = 1;
+    }
+  }
+  if(n != 0){
+    fprintf(2, "tree: cannot read directory %s\n", path);
+    status = 1;
+  }
+  close(fd);
+  return status;
+}
+
+static int
+depth(char *text)
+{
+  uint value = 0;
+
+  if(text[0] == 0)
+    return -1;
+  for(int i = 0; text[i]; i++){
+    if(text[i] < '0' || text[i] > '9' ||
+       value > (2147483647U - (text[i] - '0')) / 10)
+      return -1;
+    value = value * 10 + text[i] - '0';
+  }
+  return value;
+}
+
+int
+main(int argc, char *argv[])
+{
+  char *path = ".";
+  int maxDepth = -1, onlyDir = 0, pathset = 0;
+
+  for(int i = 1; i < argc; i++){
+    if(strcmp(argv[i], "-d") == 0){
+      onlyDir = 1;
+    } else if(strcmp(argv[i], "-L") == 0){
+      if(i + 1 == argc || (maxDepth = depth(argv[++i])) < 0){
+        fprintf(2, "tree: -L requires a non-negative integer depth\n");
+        exit(1);
+      }
+    } else if(argv[i][0] == '-' || pathset){
+      fprintf(2, "tree: usage: tree [path] [-L depth] [-d]\n");
+      exit(1);
+    } else {
+      path = argv[i];
+      pathset = 1;
+    }
+  }
+  if(strlen(path) >= MAXPATH){
+    fprintf(2, "tree: path too long\n");
+    exit(1);
+  }
+  exit(tree(path, 1, maxDepth, onlyDir));
+}
